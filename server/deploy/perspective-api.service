[Unit]
Description=Effica API
After=network-online.target mariadb.service
Requires=mariadb.service
[Service]
User=perspective
Group=perspective
WorkingDirectory=/opt/perspective-news/current
EnvironmentFile=/opt/perspective-news/current/.env
ExecStart=/opt/perspective-news/current/.venv/bin/uvicorn apps.api.app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
[Install]
WantedBy=multi-user.target
