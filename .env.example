# Copy this file to the repository-root .env and replace every placeholder.
# The real .env must be mode 600. Never create per-service env files.
EC2_IPV4_PUBLIC_ADDRESS=<ec2-ipv4-or-hostname>
EC2_SSH_USER=ubuntu
EC2_SSH_PORT=22
EC2_PASSWORD=<ssh-password>
DB_TUNNEL_PORT=13306
APP_ENV=<local|test|production>
APP_BACKEND=<mariadb|memory>
DATABASE_URL=<mysql+asyncmy://USER:PASSWORD@HOST:3306/DATABASE>
# Dedicated application/RDBMS-tool administrator. Grant scope is DATABASE.*, not global *.*.
DB_ADMIN_DATABASE=<database-name>
DB_ADMIN_USERNAME=<database-admin-username>
DB_ADMIN_PASSWORD=<same-as-EC2_PASSWORD>
DB_ADMIN_ALLOWED_HOST=127.0.0.1
# One-time provisioning connection; leave its password empty for passwordless local root auth.
MARIADB_BOOTSTRAP_HOST=127.0.0.1
MARIADB_BOOTSTRAP_PORT=3306
MARIADB_BOOTSTRAP_USER=<root-or-provisioner>
MARIADB_BOOTSTRAP_PASSWORD=<bootstrap-password-or-empty>
SESSION_SECRET=<at-least-32-random-bytes>
PUBLIC_BASE_URL=<http://localhost:8000>
WEB_BASE_URL=<http://localhost:3000>
OAUTH_REDIRECT_ALLOWLIST=<comma-separated-absolute-urls>
KAKAO_CLIENT_ID=<provider-client-id>
KAKAO_CLIENT_SECRET=<provider-client-secret>
NAVER_CLIENT_ID=<provider-client-id>
NAVER_CLIENT_SECRET=<provider-client-secret>
GOOGLE_CLIENT_ID=<provider-client-id>
GOOGLE_CLIENT_SECRET=<provider-client-secret>
LLM_PROVIDER_MODE=<stub|live>
LLM_PRIMARY_ENDPOINT=<https-provider-json-endpoint>
LLM_PRIMARY_MODEL_ID=<actual-model-id>
LLM_PRIMARY_ALIAS=<stable-model-alias>
LLM_PRIMARY_API_STYLE=<generic_json|openai_chat_completions>
LLM_PRIMARY_API_KEY=<provider-api-key>
LLM_SECONDARY_ENDPOINT=<https-provider-json-endpoint>
LLM_SECONDARY_MODEL_ID=<actual-model-id>
LLM_SECONDARY_ALIAS=<stable-model-alias>
LLM_SECONDARY_API_STYLE=<generic_json|openai_chat_completions>
LLM_SECONDARY_API_KEY=<provider-api-key>
LLM_TERTIARY_ENDPOINT=<https-provider-json-endpoint>
LLM_TERTIARY_MODEL_ID=<actual-model-id>
LLM_TERTIARY_ALIAS=<stable-model-alias>
LLM_TERTIARY_API_STYLE=<generic_json|openai_chat_completions>
LLM_TERTIARY_API_KEY=<provider-api-key>
LOG_LEVEL=<DEBUG|INFO|WARNING|ERROR>
NEXT_PUBLIC_API_BASE_URL=<http://localhost:8000/api/v1>
