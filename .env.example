# Copy this file to the repository-root .env and replace every placeholder.
# The real .env must be mode 600. Never create per-service env files.
# EC2 hosts only FastAPI, the worker, and MariaDB; Next.js production runs only on Vercel.
EC2_IPV4_PUBLIC_ADDRESS=<ec2-ipv4-or-hostname>
EC2_SSH_USER=ubuntu
EC2_SSH_PORT=22
EC2_PASSWORD=<ssh-password>
DB_TUNNEL_PORT=13306
APP_ENV=<local|test|production>
APP_BACKEND=<mariadb|memory>
DATABASE_URL=<mysql+asyncmy://USER:PASSWORD@HOST:3306/DATABASE>
# Dedicated application/RDBMS-tool administrator. Grant scope is DATABASE.*, not global *.*.
DB_ADMIN_DATABASE=<database-name>
DB_ADMIN_USERNAME=<database-admin-username>
DB_ADMIN_PASSWORD=<same-as-EC2_PASSWORD>
DB_ADMIN_ALLOWED_HOST=127.0.0.1
# One-time provisioning connection; leave its password empty for passwordless local root auth.
MARIADB_BOOTSTRAP_HOST=127.0.0.1
MARIADB_BOOTSTRAP_PORT=3306
MARIADB_BOOTSTRAP_USER=<root-or-provisioner>
MARIADB_BOOTSTRAP_PASSWORD=<bootstrap-password-or-empty>
SESSION_SECRET=<at-least-32-random-bytes>
PUBLIC_BASE_URL=<http://localhost:8000>
WEB_BASE_URL=<http://localhost:3000>
OAUTH_REDIRECT_ALLOWLIST=<exact-google-callback-url>
GOOGLE_CLIENT_ID=<provider-client-id>
GOOGLE_CLIENT_SECRET=<provider-client-secret>
LLM_PROVIDER_MODE=<auto|stub|live>
OPENAI_API_KEY=<openai-api-key>
# Fallbacks used until an ACTIVE OpenAI model exists in the admin model table.
LLM_MODEL=gpt-5.6-luna
LLM_MODEL_ALIAS=openai-default
LLM_REASONING_EFFORT=xhigh
# Structured comparison requests may require longer than the provider's short default.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
# Fixed by runtime validation; outbound LLM traffic may only use this endpoint.
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
# Worker leases, bounded concurrency and the database-led periodic crawl scheduler.
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=45
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_SHUTDOWN_GRACE_SECONDS=195
WORKER_MAX_CONCURRENCY=4
WORKER_QUEUE_ERROR_BACKOFF_BASE_SECONDS=1
WORKER_QUEUE_ERROR_BACKOFF_MAX_SECONDS=30
WORKER_CRAWL_SCHEDULER_ENABLED=true
WORKER_CRAWL_INTERVAL_SECONDS=900
WORKER_CRAWL_BATCH_SIZE=50
WORKER_CRAWL_MAX_ATTEMPTS=5
LOG_LEVEL=<DEBUG|INFO|WARNING|ERROR>
# Local browsers and Vercel call the same-origin /api/v1 boundary.
# Production Vercel API_BACKEND_URL is the TLS-enabled EC2 nginx API origin.
API_BACKEND_URL=<http://127.0.0.1:8000>
NEXT_PUBLIC_API_MODE=<mock|real>
# Vercel CLI production deployment authentication (create in Vercel Account Settings > Tokens).
VERCEL_TOKEN=<vercel-access-token>
